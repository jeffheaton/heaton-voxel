 "conventions": {
  "binary": "lowercase hex",
  "digests": "sha256, lowercase hex; NBT digests are always of the UNCOMPRESSED encoding -- compressed bytes are not portable across zlib implementations. chunk_deletes.json is the one artifact that digests whole region files, compressed records and all: deleting a chunk recompresses nothing, so those bytes are reproducible in any language",
  "floats": "IEEE-754 bits as hex in 'bits'; compare bits, never values",
  "int64": "decimal strings",
  "strings": "non-printable-ASCII strings appear as codepoint arrays under 'cp'; in snbt.json only those holding a lone surrogate do, and its others are JSON strings under 'v', escapes and all"
 },
