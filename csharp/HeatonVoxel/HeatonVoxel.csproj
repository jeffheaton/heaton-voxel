<Project Sdk="Microsoft.NET.Sdk">
  <!-- netstandard2.1 + C# 9: the surface Unity consumes. No package
       references, ever: the port carries the Python library's rule that the
       formats are parsed directly, with no runtime dependencies. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>HeatonVoxel</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Description>A from-scratch Minecraft (Java Edition) save toolkit: NBT and
      Anvil regions, paletted chunk contents, whole-save editing, Sponge .schem
      interchange, and the game's neighbor-derived block states. Port of the
      Python reference; conforms to the shared corpus.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <!-- One release, two packages: this version moves with pyproject.toml's,
         and tests/test_architecture.py holds them equal. -->
    <PackageId>HeatonVoxel</PackageId>
    <Version>0.1.0</Version>
    <Authors>Jeff Heaton</Authors>
    <Copyright>Copyright 2026 Jeff Heaton</Copyright>
    <PackageProjectUrl>https://github.com/jeffheaton/heaton-voxel</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jeffheaton/heaton-voxel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>minecraft;nbt;anvil;region;schematic;voxel;unity</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Ship IntelliSense docs alongside the DLL (Unity reads the .xml next to
         it). CS1591 stays off: undocumented public members are fine, and with
         TreatWarningsAsErrors it would otherwise fail the build outright. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- The package's own page, and the NOTICE the license asks to travel
         with every copy. -->
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
