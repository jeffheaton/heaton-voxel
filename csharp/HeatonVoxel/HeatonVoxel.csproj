<Project Sdk="Microsoft.NET.Sdk">
  <!-- netstandard2.1 + C# 9: the surface Unity consumes. No package
       references, ever: the port carries the Python library's rule that the
       formats are parsed directly, with no runtime dependencies. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>HeatonVoxel</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Description>Read and edit Minecraft Java Edition worlds from .NET and
      Unity: blocks placed the way the game places them, settings, undo, and
      WorldEdit, Litematica and structure files. The twin of the Python
      heaton-voxel library, held to the same test corpus byte for byte.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <!-- One release, two packages: this version moves with pyproject.toml's,
         and tests/test_architecture.py holds them equal. -->
    <PackageId>HeatonVoxel</PackageId>
    <Version>0.1.0</Version>
    <Authors>Jeff Heaton</Authors>
    <Copyright>Copyright 2026 Jeff Heaton</Copyright>
    <PackageProjectUrl>https://github.com/jeffheaton/heaton-voxel</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jeffheaton/heaton-voxel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>minecraft;nbt;anvil;region;schematic;voxel;unity</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Ship IntelliSense docs alongside the DLL (Unity reads the .xml next to
         it). CS1591 stays off: undocumented public members are fine, and with
         TreatWarningsAsErrors it would otherwise fail the build outright. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Symbols for a debugger stepping into the package: a .snupkg beside the
         .nupkg, with Source Link (built into the .NET SDK, no package
         reference) pointing each file at its commit on GitHub. A CI build
         maps its paths so the DLL does not carry the runner's. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <!-- The package's own page, and the NOTICE the license asks to travel
         with every copy. -->
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
